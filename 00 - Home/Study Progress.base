summaries:
  avg_completion: values.filter(value.isType("number")).mean().round(0).toString() + "%"
filters:
  and:
    - file.hasTag("exercise")
formulas:
  folder_topic: file.folder.split("/")[0]
  completion: if(status == "completed", 100, if(status == "in-progress", 50, 0))
  priority_score: if(difficulty == "beginner", 1, if(difficulty == "intermediate", 2, 3))
  status_icon: if(status == "completed", "✅", if(status == "in-progress", "🔄", "⏳"))
  difficulty_stars: if(difficulty == "beginner", "⭐", if(difficulty == "intermediate", "⭐⭐", if(difficulty == "advanced", "⭐⭐⭐", "—")))
  metadata_status: if(topic, if(difficulty, if(status, "Ready", "Needs metadata"), "Needs metadata"), "Needs metadata")
properties:
  status:
    displayName: Status
  difficulty:
    displayName: Difficulty
  source:
    displayName: Source
  formula.folder_topic:
    displayName: Chapter
  formula.completion:
    displayName: Completion
  formula.status_icon:
    displayName: Progress
  formula.difficulty_stars:
    displayName: Level
  formula.metadata_status:
    displayName: Metadata
views:
  - type: table
    name: Study Queue
    filters:
      and:
        - status != "completed"
    groupBy:
      property: difficulty
      direction: ASC
    order:
      - formula.status_icon
      - file.name
      - formula.folder_topic
      - formula.difficulty_stars
      - source
    limit: 20
  - type: cards
    name: Progress Cards
    groupBy:
      property: formula.folder_topic
      direction: ASC
    order:
      - file.name
      - formula.status_icon
      - formula.difficulty_stars
      - formula.completion
  - type: table
    name: Beginner Track
    filters:
      and:
        - difficulty == "beginner"
    order:
      - file.name
      - formula.status_icon
      - source
  - type: table
    name: Advanced Track
    filters:
      and:
        - difficulty == "advanced"
    order:
      - file.name
      - formula.status_icon
      - source
  - type: table
    name: Needs Metadata
    filters:
      and:
        - formula.metadata_status == "Needs metadata"
    order:
      - file.name
      - formula.folder_topic
      - topic
      - difficulty
      - status
